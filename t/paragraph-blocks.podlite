=begin test :id<blank-line-ends-a-for-block> :caption('a blank line ends a block introduced by =for')
=begin fixture
=begin pod
=for head2
Title

Text after the blank line.
=end pod
=end fixture
=for assert :caption('the blank line ends the heading; the text after it lies between blocks and is a para block')
para

=begin fixture
=begin pod
=for head2
Title
Text on the next line.
=end pod
=end fixture
=for assert :absent :caption('without the blank line the text is part of the contents of the heading and no para block arises')
para
=end test

=begin test :id<for-marker-carries-configuration> :caption('a =for marker carries configuration for its block')
=begin fixture
=for para :x<1>
text
=end fixture
=for assert
para[ :x<1> ]
=end test

=begin test :id<item-text-is-an-ordinary-paragraph> :caption('the text of an item is a para block in each of the three forms')
=begin fixture
=config para :x<1>
=item Abbreviated item text
=end fixture
=for assert :caption('the text on the directive line of an abbreviated item is a para block and gets the value 1 from =config')
para[ :x<1> ]

=begin fixture
=config para :x<1>
=item Abbreviated item text
continued abbreviated item text
=end fixture
=for assert :caption('the text of the abbreviated item with a continuation line is a para block and gets the value 1 from =config')
para[ :x<1> ]

=begin fixture
=config para :x<1>
=for item
For item text
continued for item text
=end fixture
=for assert :caption('the text of the =for item is a para block and gets the value 1 from =config')
para[ :x<1> ]

=begin fixture
=config para :x<1>
=begin item
Delimited item text
continued delimited item text
=end item
=end fixture
=for assert :caption('the text of the delimited item is a para block and gets the value 1 from =config')
para[ :x<1> ]
=end test

=begin test :id<indented-continuation-in-abbreviated-item> :caption('an indented line under an abbreviated item continues its text')
=begin fixture
=item Happy
    and glad
=end fixture
=for assert :absent :caption('the indented line does not start a code block')
code
=for assert :caption('the text of the abbreviated item is a para block')
para

=begin fixture
=begin item
Happy

    and glad
=end item
=end fixture
=for assert :caption('in a delimited item an indented line after a blank line is a code block')
code
=end test

=begin test :id<indented-line-continues-a-paragraph> :caption('the first line decides an ordinary paragraph, and an indented line continues it')
=begin fixture
Plain text of a paragraph
    continued on an indented line.
=end fixture
=for assert :caption('the text is a paragraph')
para
=for assert :absent :caption('the indented line does not start a code block')
code
=end test
