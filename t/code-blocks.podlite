=begin test :id<indented-text-in-nested-is-code> :caption('indented text inside =nested is a code block; the fixture has no =code, so only the implicit block can match')
=begin fixture
=begin nested
    indented text
=end nested
=end fixture
=for assert
code
=end test

=begin test :id<line-at-the-margin-continues-code> :caption('the first line decides an implicit code block, and a line at the margin continues it')
=begin fixture
    my $x = 1;
say $x;
=end fixture
=for assert :caption('the text is a code block')
code
=for assert :absent :caption('the line at the margin does not start a paragraph')
para
=end test

=begin test :id<directive-ends-implicit-code> :caption('a directive ends an implicit code block')
=begin fixture
    sample
=head3 End
=end fixture
=for assert :caption('the indented text is code')
code
=for assert :caption('the directive on the next line starts a block')
head3
=end test

=begin test :id<allow-holds-a-list-of-codes> :caption(':allow on a code block holds a list of markup code names')
=begin fixture
=for code :allow<B I>
B<x> I<y>
=end fixture
=for assert :caption('the first name is in the list')
code[ :allow~<B> ]
=for assert :caption('the second name is in the list')
code[ :allow~<I> ]
=end test

=begin test :id<indented-text-in-item-and-defn-forms-is-text> :caption('indented text in the abbreviated and paragraph forms of =item and =defn is text')
=begin fixture
=for item
    Install the package first.
=end fixture
=for assert :caption('the text of =for item is a paragraph')
para
=for assert :absent :caption('and not a code block')
code

=begin fixture
=item
    Install the package first.
=end fixture
=for assert :caption('the text of a bare =item is a paragraph')
para
=for assert :absent :caption('and not a code block')
code

=begin fixture
=defn virtual margin
    The column at which a block's directive starts.
=end fixture
=for assert :caption('the definition is a paragraph')
para
=for assert :absent :caption('and not a code block')
code

=begin fixture
=for defn
Term
    Definition.
=end fixture
=for assert :caption('the definition of =for defn is a paragraph')
para
=for assert :absent :caption('and not a code block')
code
=end test
