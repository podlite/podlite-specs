=begin test :id<include-selector-reads-the-source> :caption('a selector on =include reads its source without the configuration of the including document')
=begin resource :name<part.podlite>
=para Plain.
=end resource
=begin fixture
=config para :v<1>
=include file:./part.podlite | para[ :v<1> ]

=for para :src<own>
After.
=end fixture
=for assert :caption('the paragraph of the including document is present')
para[ :src<own> ]
=for assert :absent :caption('the source paragraph without a value for :v is not included')
para[ :!?src ]
=end test

=begin test :id<selector-reads-nested-includes> :caption('a selector reads a source whose own includes and configuration are resolved')
=begin resource :name<leaf.podlite>
=para Leaf.
=end resource
=begin resource :name<part.podlite>
=config para :v<part>
=include file:./leaf.podlite
=end resource
=begin fixture
=config para :v<book>
=include file:./part.podlite | para[ :v<part> ]
=end fixture
=for assert :caption('the nested included paragraph is selected with the value part')
para[ :v<part> ]
=for assert :absent :caption('the value book from the including document does not replace the value part')
para[ :v<book> ]
=end test

=begin test :id<relative-path-from-the-file-it-is-written-in> :caption('a relative path resolves against the file it is written in')
=begin resource :name<includes/guide.podlite>
=include file:./part.podlite
=end resource
=begin resource :name<includes/part.podlite>
=head2 Inner
=end resource
=begin resource :name<part.podlite>
=head3 Wrong
=end resource
=begin fixture
=include file:./includes/guide.podlite
=end fixture
=for assert :caption('the file beside the including file is reached')
head2
=for assert :absent :caption('the file beside the parent is not')
head3
=end test

=begin test :id<address-names-a-block-by-id> :caption('an internal address in an include source names a block by its :id')
=begin resource :name<part.podlite>
=for para :id<first>
First.

=for para :id<second>
Second.
=end resource
=begin fixture
=include file:./part.podlite#second
=end fixture
=for assert :caption('the addressed block is brought in')
para[ :id<second> ]
=for assert :absent :caption('the other block of the file is not')
para[ :id<first> ]
=end test

=begin test :id<address-ends-at-whitespace> :caption('an internal address in a selector operand ends at whitespace')
=begin resource :name<part.podlite>
=for para :id<first>
First.

=for para :id<second>
Second.
=end resource
=begin fixture
=include file:./part.podlite#second | para
=end fixture
=for assert :caption('the address is read up to the whitespace before the selection')
para[ :id<second> ]
=for assert :absent :caption('the other block of the file is not brought in')
para[ :id<first> ]
=end test

=begin test :id<omitted-scheme-is-file> :caption('a source written without a scheme is read as file:')
=begin resource :name<part.podlite>
=head2 Part
=end resource
=begin fixture
=include part.podlite | head2
=end fixture
=for assert :caption('the file is read')
head2
=end test

=begin test :id<column-address-in-data> :caption('a column of a data source is addressed by its declared heading')
=begin fixture
=begin data :key<statuses> :mime-type('text/tab-separated-values; header=present')
value	label
draft	Draft
=end data

=for Invoice :id<a> :status<draft>
A.

=for Invoice :id<b> :status<Draft>
B.
=end fixture
=for assert :caption('a value in the addressed column selects the block')
Invoice[ :id<a> :status(in data:statuses#value) ]
=for assert :absent :caption('a value only in another column does not')
Invoice[ :id<b> :status(in data:statuses#value) ]
=for assert :caption('the other column, addressed by its heading, holds it')
Invoice[ :id<b> :status(in data:statuses#label) ]
=end test

=begin test :id<universal-pattern-selects-by-configuration> :caption('the universal pattern selects blocks of any name by configuration')
=begin resource :name<part.podlite>
=for head1 :platform<arm>
Head.

=for para :platform<arm>
Para.

=for para :platform<x86>
Other.
=end resource
=begin fixture
=include file:./part.podlite | *[ :platform<arm> ]
=end fixture
=for assert :caption('a heading is selected')
head1
=for assert :caption('a paragraph is selected')
para[ :platform<arm> ]
=for assert :absent :caption('a block failing the predicate is not')
para[ :platform<x86> ]
=end test

=begin test :id<universal-pattern-without-predicate> :caption('a universal pattern without a predicate selects every block')
=begin resource :name<part.podlite>
=head1 Title

=para Text.

=code x
=end resource
=begin fixture
=include file:./part.podlite | *
=end fixture
=for assert :caption('the heading is selected')
head1
=for assert :caption('the paragraph is selected')
para
=for assert :caption('the code block is selected')
code
=end test

=begin test :id<whitespace-joins-conditions> :caption('a block is selected only when every condition holds')
=begin fixture
=for code :id<both> :lang<python> :numbered
x

=for code :id<one> :lang<python>
y
=end fixture
=for assert :caption('both conditions hold')
code[ :id<both> :lang<python> :numbered ]
=for assert :absent :caption('one condition does not suffice')
code[ :id<one> :lang<python> :numbered ]
=end test

=begin test :id<comma-joins-patterns> :caption('a block is selected when it matches any of the patterns')
=begin resource :name<part.podlite>
=head1 Title

=for code :lang<python>
x

=for code :lang<perl>
y

=para Text.
=end resource
=begin fixture
=include file:./part.podlite | head1, code[ :lang<python> ]
=end fixture
=for assert :caption('the first pattern selects')
head1
=for assert :caption('the second pattern selects')
code[ :lang<python> ]
=for assert :absent :caption('a block matching neither is not selected')
code[ :lang<perl> ], para
=end test

=begin test :id<undeclared-attribute> :caption('a condition naming an attribute no block declares holds for no block')
=begin fixture
=para Text.
=end fixture
=for assert :caption('the paragraph is there')
para
=for assert :absent :caption('a condition on an undeclared attribute selects nothing')
para[ :nosuch ], para[ :?nosuch ]
=end test

=begin test :id<kinds-of-value-do-not-interrupt> :caption('a value of a kind the test does not admit is a non-match and the selection goes on')
=begin resource :name<part.podlite>
=for para :id<hash> :v{a => 1}
Hash.

=for para :id<list> :v(1,2)
List.

=for para :id<string> :v<x>
String.
=end resource
=begin fixture
=include file:./part.podlite | *[ :v<x> ]
=end fixture
=for assert :caption('the block after the hash and the list is selected')
para[ :id<string> ]
=for assert :absent :caption('the hash and the list are non-matches')
para[ :id<hash> ], para[ :id<list> ]
=end test
